# Copy to .env with `make env` (generates the two secrets below).
# .env is git-ignored; this example file is committed.

# --- Airflow ---
# Encrypts connection passwords/variables stored in the metadata DB.
AIRFLOW_FERNET_KEY=generated-by-make-env
# Signs the tokens tasks use to talk to the API server.
AIRFLOW_JWT_SECRET=generated-by-make-env
# Linux only: your `id -u`, so files written by containers belong to you.
AIRFLOW_UID=50000
# Port of the Airflow UI on your machine (change it if 8080 is taken).
AIRFLOW_PORT=8080

# --- Data warehouse (Postgres) ---
FX_DB_USER=fx
FX_DB_PASSWORD=fx
FX_DB_NAME=fx
FX_DB_PORT=5433

# --- Object storage (RustFS, S3-compatible) ---
S3_ACCESS_KEY=fxadmin
S3_SECRET_KEY=fxadmin-secret
