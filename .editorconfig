# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# Same as ruff (pyproject.toml).
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
